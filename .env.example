# Used by docker compose and `make dev-api`
POSTGRES_USER=gpx
POSTGRES_PASSWORD=gpx
POSTGRES_DB=gpx
DATABASE_URL=postgres://gpx:gpx@localhost:5432/gpx?sslmode=disable
PORT=8080
# Set to true when served over HTTPS
COOKIE_SECURE=false
MAX_UPLOAD_MB=20
# false: only the first account signs up; admins invite everyone else
REGISTRATION_ENABLED=true
# Public URL of the app, used in links sent by email
APP_URL=http://localhost:8080
# Behind a reverse proxy: the header with the client IP, and the proxies allowed to set it
REAL_IP_HEADER=
TRUSTED_PROXIES=
# Mailpit from `make dev-db`; inbox at http://localhost:8025. Leave SMTP_HOST empty to run without email.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=GPX Viewer <noreply@gpx.local>
